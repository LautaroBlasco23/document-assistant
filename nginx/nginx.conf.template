# Docker DNS resolver for runtime upstream resolution
resolver 127.0.0.11 valid=10s;

server {
    listen 80;
    server_name ${DOMAIN};

    # API — long timeouts for background summarise/flashcard tasks
    # Use variables to force runtime DNS resolution
    set $api_upstream backend:8000;
    location /api {
        proxy_pass http://$api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${FORWARDED_PROTO};
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # Vite hashed assets — served with immutable cache headers
    set $assets_upstream frontend:80;
    location /assets/ {
        proxy_pass http://$assets_upstream;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA — everything else goes to the React app
    set $spa_upstream frontend:80;
    location / {
        proxy_pass http://$spa_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${FORWARDED_PROTO};
    }
}
